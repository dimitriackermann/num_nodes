<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>num_nodes</name>
  <version>0.1.0</version>
  <description>Counter publisher/subscriber and add/subtract service server and client.</description>
  <maintainer email="dimitri.ackermann@googlemail.com">Dimitri Ackermann</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>num_interfaces</exec_depend>
  <!-- num_add / num_sub are plain pip packages from py_packages/ (not rosdep keys);
       they are installed by scripts/setup_workspace.sh. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
